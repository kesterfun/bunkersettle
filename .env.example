# Copy to .env (never commit .env). No secrets are needed to compile or test.
# Set to any non-empty value to enable the gas reporter.
REPORT_GAS=

# Optional: an account created in your own MetaMask ("Add account") to act as the
# financier, for wallets that can't import Hardhat account #9. `npm run deploy`
# registers it as "Straits Trade Finance" (FINANCIER) and funds it.
DEMO_FINANCIER=
